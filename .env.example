# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_SEAT=
STRIPE_PRICE_MAX_SEAT=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical-host redirect (production):
# Set CANONICAL_HOST to the bare host (no scheme/port) that should serve
# everything, and NEXXUS_REDIRECT_HOSTS to a comma-separated list of
# hostnames that should 308-redirect to it. Common case: Vercel projects
# get an auto-generated *.vercel.app URL alongside the custom domain — point
# the vercel.app URL at the custom domain so OAuth state cookies, SEO, and
# webhook receivers don't get split across two hosts.
# Example:
#   CANONICAL_HOST=nexxuscrm.com
#   NEXXUS_REDIRECT_HOSTS=crmai-xi.vercel.app
# Leave both blank to disable redirect (local dev / preview deployments).
CANONICAL_HOST=
NEXXUS_REDIRECT_HOSTS=

# Desktop App Authentication
DESKTOP_JWT_SECRET=
DESKTOP_TOKEN_EXPIRY=3600

# Groq Cloud LLM API
GROQ_API_KEY=

# Sentry Error Reporting
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cron Jobs (optional)
CRON_SECRET=

# Upstash Redis (rate limiting). Falls back to in-memory if not set —
# in-memory does NOT share state across serverless instances, so leave
# unset only for local dev / CI, never in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — transactional email provider. Without a key, sendEmail() persists
# the row as 'failed' with failure_reason='resend_not_configured'. Setup
# instructions: docs/email-setup.md.
RESEND_API_KEY=
# Signing secret for inbound delivery events at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
# Verified domain in Resend (e.g. nexxuscrm.com). Used to build the default
# From address when EMAIL_FROM_ADDRESS is not set.
EMAIL_FROM_DOMAIN=
# Optional override for the full From line, e.g. "Nexxus <hello@nexxuscrm.com>".
# When unset, defaults to "Nexxus <no-reply@$EMAIL_FROM_DOMAIN>".
EMAIL_FROM_ADDRESS=
# Optional From for sequence emails. Falls back to EMAIL_FROM_ADDRESS/DOMAIN.
SEQUENCE_FROM_EMAIL=

# Google OAuth (Gmail inbox sync + Google Calendar) — see docs/inbox-setup.md
# Create an OAuth 2.0 Client in Google Cloud Console with redirect URI
# `${NEXT_PUBLIC_APP_URL}/api/oauth/google/callback`. Required scopes:
# openid, email, profile, gmail.readonly, gmail.metadata, calendar.events.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Token encryption — AES-256-GCM at rest for oauth_tokens.access_token /
# refresh_token and webhook_endpoints.secret. Must be a base64-encoded
# 32-byte key in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Google Cloud Pub/Sub — required for Gmail inbox push notifications.
# Topic format: projects/<gcp-project-id>/topics/<topic-name>.
# Audience must match the push subscription's `audience` field exactly.
# See docs/inbox-setup.md for full setup.
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=

# WhatsApp Cloud API — see docs/whatsapp-setup.md.
# BYO mode requires each customer to bring their own Meta App + provide the
# App Secret in the integrations UI; no env vars needed.
#
# Embedded Signup mode requires our Meta Business Verification + a single
# shared App. Fill these to enable the "Connect via Meta" button:
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
# config_id from Meta Business Solutions Partner UI for the Embedded
# Signup flow targeting WhatsApp Business onboarding.
WHATSAPP_META_CONFIG_ID=
# Fallback App Secret used by /api/webhooks/whatsapp when the per-team
# row in whatsapp_settings has no app_secret_encrypted (Embedded Signup
# customers, since the shared Meta App owns the secret).
WHATSAPP_APP_SECRET=

# CRM importers — OAuth credentials for connecting customer CRMs and
# pulling contacts/companies/deals into Nexxus. See docs/importers-setup.md.
# Leave the per-provider vars empty to disable a provider — the UI gates
# the Connect button on the corresponding /configured flag.
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
# AmoCRM (Kommo) integration ID + secret key from amoCRM Integrations page.
AMOCRM_INTEGRATION_ID=
AMOCRM_SECRET_KEY=
