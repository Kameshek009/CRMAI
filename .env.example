# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_SEAT=
STRIPE_PRICE_MAX_SEAT=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Desktop App Authentication
DESKTOP_JWT_SECRET=
DESKTOP_TOKEN_EXPIRY=3600

# Groq Cloud LLM API
GROQ_API_KEY=

# Sentry Error Reporting
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cron Jobs (optional)
CRON_SECRET=

# Upstash Redis (rate limiting). Falls back to in-memory if not set —
# in-memory does NOT share state across serverless instances, so leave
# unset only for local dev / CI, never in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
