# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_SEAT=
STRIPE_PRICE_MAX_SEAT=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Desktop App Authentication
DESKTOP_JWT_SECRET=
DESKTOP_TOKEN_EXPIRY=3600

# Groq Cloud LLM API
GROQ_API_KEY=

# Sentry Error Reporting
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cron Jobs (optional)
CRON_SECRET=

# Upstash Redis (rate limiting). Falls back to in-memory if not set —
# in-memory does NOT share state across serverless instances, so leave
# unset only for local dev / CI, never in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — transactional email provider. Without a key, sendEmail() persists
# the row as 'failed' with failure_reason='resend_not_configured'. Setup
# instructions: docs/email-setup.md.
RESEND_API_KEY=
# Signing secret for inbound delivery events at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
# Verified domain in Resend (e.g. nexxuscrm.com). Used to build the default
# From address when EMAIL_FROM_ADDRESS is not set.
EMAIL_FROM_DOMAIN=
# Optional override for the full From line, e.g. "Nexxus <hello@nexxuscrm.com>".
# When unset, defaults to "Nexxus <no-reply@$EMAIL_FROM_DOMAIN>".
EMAIL_FROM_ADDRESS=
# Optional From for sequence emails. Falls back to EMAIL_FROM_ADDRESS/DOMAIN.
SEQUENCE_FROM_EMAIL=
