{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/dispatch-webhooks",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sequence-processor",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/purge-deleted-accounts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/lead-scoring-recompute",
      "schedule": "0 2 * * *"
    }
  ]
}
